@inherits LayoutComponentBase

<div class="shell">
    <header class="masthead">
        <span class="mark">&#955;</span>
        <span class="masthead-title">lambda-web-function-not-node</span>
        <a class="masthead-link"
           href="https://docs.aws.amazon.com/lambda/latest/dg/web-functions.html"
           target="_blank" rel="noreferrer">Web Functions</a>
    </header>

    <main class="main">
        @Body
    </main>

    <footer class="footer">
        Blazor Web App on a Lambda Web Function &middot; served by a non-Node backend
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>
