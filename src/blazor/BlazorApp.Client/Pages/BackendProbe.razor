@*
    Prerendering is off on purpose: this component must fetch in the browser, so
    the call it makes is unambiguously a client -> Web Function round trip. With
    prerendering on, OnInitializedAsync would also run on the server, where no
    HttpClient is registered for the client project.
*@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http

<div class="probe">
    @if (_loading && _hello is null)
    {
        <p class="probe-status">Calling <code>/api/hello</code>&hellip;</p>
    }
    else if (_error is not null)
    {
        <p class="probe-status is-error">@_error</p>
    }
    else if (_hello is not null)
    {
        <dl class="kv">
            <dt>status</dt>
            <dd>@_hello.Status</dd>
            <dt>backend</dt>
            <dd>@_hello.Backend</dd>
            <dt>server</dt>
            <dd>@_hello.Server</dd>
            <dt>served at</dt>
            <dd>@_hello.ServedAt</dd>
        </dl>
    }

    <button class="btn" @onclick="FetchAsync" disabled="@_loading">
        @(_loading ? "Fetching..." : "Fetch again")
    </button>

    <p class="note">
        These values arrived over HTTP from the Web Function. This component is running
        in your browser as WebAssembly.
    </p>
</div>

@code {
    private HelloResponse? _hello;
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => FetchAsync();

    private async Task FetchAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _hello = await Http.GetFromJsonAsync<HelloResponse>("/api/hello");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
