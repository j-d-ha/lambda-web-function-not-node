<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.jdha</groupId>
  <artifactId>java-aot-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>java-aot-api</name>

  <properties>
    <!-- Java 25 is the current LTS and, for this backend, a hard requirement:
         Spring Boot 4 refuses to start in a native image built with an earlier
         Java, so the GraalVM build below is pinned to JDK 25 as well. -->
    <java.version>25</java.version>
  </properties>

  <dependencies>
    <dependency>
      <!-- Spring Boot 4 split the catch-all starters: the servlet stack moved
           from spring-boot-starter-web to spring-boot-starter-webmvc. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Configured here, not in a profile of its own: the parent's `native`
             profile already wires process-aot and the reachability metadata, so
             `mvn -Pnative package` needs only the two knobs below. The
             execution is load-bearing too: the profile only *configures* the
             plugin, and a plugin that is never bound never builds an image. -->
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-native</id>
            <phase>package</phase>
            <goals>
              <goal>compile-no-fork</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- The shim's contract is a binary called `server` in the zip root. -->
          <imageName>server</imageName>
          <buildArgs>
            <!-- java.net.http, used for the /ready POST, needs the plain-HTTP
                 protocol: GraalVM only ships https, file and jar by default. -->
            <buildArg>--enable-url-protocols=http</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
